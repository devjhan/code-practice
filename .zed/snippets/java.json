{
  "Parameterized Test Cases": {
    "prefix": "algo:cases",
    "body": [
      "static Stream<Arguments> cases() {",
      "    return Stream.of(",
      "        Arguments.of($1)",
      "    );",
      "}"
    ],
    "description": "JUnit 5 MethodSource cases"
  },
  "AssertJ Order-Independent Comparison": {
    "prefix": "algo:assert-order",
    "body": [
      "assertThat(${1:actual}).containsExactlyInAnyOrder(${2:expected});"
    ],
    "description": "AssertJ order-independent collection/array comparison"
  },
  "AssertJ Order-Independent Nested Elements": {
    "prefix": "algo:assert-elements",
    "body": [
      "assertThat(${1:actual}).containsExactlyInAnyOrderElementsOf(${2:expected});"
    ],
    "description": "AssertJ order-independent nested collection comparison"
  }
}



